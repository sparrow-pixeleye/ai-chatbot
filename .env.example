# APRATIM'S AI 2.0 - Environment Configuration

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-here
PORT=5000

# AI Model API Keys (Optional but recommended for best performance)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here  
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///apratim_ai.db
# Alternative: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/apratim_ai
# Alternative: MongoDB
# MONGODB_URI=mongodb://localhost:27017/apratim_ai

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Performance Settings
MAX_TOKENS=2000
RESPONSE_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_VOICE_FEATURES=true
ENABLE_REAL_TIME_SEARCH=true
ENABLE_CODE_EXECUTION=false
ENABLE_IMAGE_GENERATION=false

# Security Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
JWT_SECRET_KEY=your-jwt-secret-key
SESSION_TIMEOUT=86400

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/apratim_ai.log

# Analytics and Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_API_KEY=your_analytics_key_here

# External Services
WEATHER_API_KEY=your_weather_api_key
NEWS_API_KEY=your_news_api_key
SEARCH_API_KEY=your_search_api_key